{
  "expo": {
    "name": "Movvy",
    "slug": "movvy",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "movvy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#0B0B0E"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.movvy.app",
      "icon": "./assets/icon.png",
      "associatedDomains": [
        "applinks:movvy.ca"
      ],
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tel",
          "telprompt",
          "mailto",
          "maps",
          "comgooglemaps",
          "https",
          "http"
        ]
      }
    },
    "android": {
      "package": "com.movvy.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#059669"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "movvy.ca",
              "pathPrefix": "/join"
            },
            {
              "scheme": "movvy",
              "host": "join"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Movvy needs access to your photos so you can attach images of items being moved.",
          "cameraPermission": "Movvy uses your camera to photograph your documents and items being moved."
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#059669"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Movvy uses your location to center the map on where you are so you can book a move from there faster."
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "",
          "enableGooglePay": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    }
  }
}
