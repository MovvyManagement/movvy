# =============================================================================
# Stripe Connect sample — environment
#
# Copy this file to `.env` and fill in real values. The .env file is git-
# ignored. Never commit a live secret key.
# =============================================================================

# Your platform's secret key. Grab it from the Stripe Dashboard at:
#   https://dashboard.stripe.com/test/apikeys
# In test mode it starts with `sk_test_...`. In live mode `sk_live_...`.
STRIPE_SECRET_KEY=sk_test_replace_me

# Webhook signing secret printed by `stripe listen` when you start the local
# forwarder, or copied from the dashboard if you've created the destination
# in production. Starts with `whsec_...`.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Public origin where this server is reachable. The accountLinks return /
# refresh URLs and the Checkout success URL are built off this. Override
# in production with your real domain.
PUBLIC_BASE_URL=http://localhost:4242

# Port the Express app binds to.
PORT=4242
