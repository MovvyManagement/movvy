# =============================================================================
# Movvy — Environment variables
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — NEVER commit secrets.
#
# Cost notes for paid APIs are next to each variable so you know what you're
# enabling when you flip a feature flag.
# =============================================================================

# ─── PUBLIC (safe to ship in the mobile bundle, gated by RLS) ───────────────
#
# These are read by the Expo app at build time and embedded in the bundle.
# Supabase's "publishable" key is DESIGNED to be public; RLS is the gate.
# Never put anything more sensitive than the publishable key behind EXPO_PUBLIC_*.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Per-environment overrides (optional). EAS rewrites these per profile from
# GitHub Actions secrets; set them locally only when running a staging build
# against a non-default backend. See ENV.md for the full recipe.
# STAGING_SUPABASE_URL=
# STAGING_SUPABASE_ANON_KEY=
# PROD_SUPABASE_URL=
# PROD_SUPABASE_ANON_KEY=

# App env tag (development | staging | production). Sentry env + safety
# guards key off it. EAS sets it automatically per profile — only set
# manually when running locally against another backend.
# APP_ENV=development

# ─── SERVER-ONLY (Edge Functions only — NEVER ship to client) ───────────────
#
# These live in Supabase Functions secrets (`supabase secrets set ...`) and in
# this file only on your dev machine. The .gitignore blocks accidental commit.

# Supabase service-role / secret key. Bypasses RLS — treat like a root password.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# ─── PAID THIRD-PARTY APIS (server-only, controlled by feature flags) ───────
#
# Each of these costs money per call. Movvy guards them with:
#   1. feature_flags table — paid APIs default to DISABLED
#   2. api_budgets table — daily $ cap; over cap = fallback to free or refuse
#   3. Per-user + per-IP rate limits
#   4. 1-hour response cache to dedupe identical queries
#
# To actually start spending: set the key here, push to Functions secrets,
# AND flip the corresponding feature flag in the DB.
#
# Cost reference (as of 2026):

# Google Maps Platform — Places Autocomplete $2.83/1k after free tier
#                        Place Details        $17/1k
#                        Geocoding            $5/1k
#                        Directions           $5/1k
#                        Distance Matrix      $5/1k
# Free tier: $200/month credit ≈ 100k autocomplete requests.
# RESTRICT THE KEY in Google Cloud Console:
#   - Application restrictions: HTTP referrers OR IP addresses
#   - API restrictions: enable only Places API, Geocoding API, Directions API, Distance Matrix
#   - Set a daily cap per API in Google Cloud Console too (belt-and-suspenders)
GOOGLE_MAPS_SERVER_KEY=

# ─── MOBILE MAPS SDK KEY (client — baked into the native app binary) ────────
#
# SEPARATE key from GOOGLE_MAPS_SERVER_KEY above. This one renders the native
# map (react-native-maps, provider=Google) on iOS + Android, so it necessarily
# ships inside the app. Read by app.config.ts at build time (NOT EXPO_PUBLIC_*;
# it's consumed in native config, not JS). Without it, map screens render blank.
#
# Create in Google Cloud → Credentials → API key, then:
#   - Enable APIs: "Maps SDK for iOS" + "Maps SDK for Android"
#   - Application restrictions (make TWO keys if you want per-platform limits):
#       iOS     → iOS apps → bundle id  com.movvy.app
#       Android → Android apps → package com.movvy.app + signing SHA-1
#                 (get SHA-1 from `eas credentials -p android`, or the debug
#                  keystore for local dev builds)
#   - API restrictions: limit to just the two Maps SDKs above
GOOGLE_MAPS_MOBILE_KEY=

# Stripe — flat 2.9% + $0.30 per transaction; no per-API-call cost
# Use TEST mode keys (sk_test_...) until ready for real payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Twilio (SMS to mask phone numbers) — ~$0.0079 per SMS in Canada
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Expo Push (free, but rate-limited by Expo at ~600 notifications/sec)
EXPO_ACCESS_TOKEN=

# Checkr (driver background checks) — $25–$60 per check
CHECKR_API_KEY=

# Sentry (error monitoring) — free dev tier, scales with event volume
SENTRY_DSN=
