{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "base": {
      "node": "20.18.0",
      "env": {
        "EXPO_NO_GIT_STATUS": "1"
      },
      "android": {
        "image": "latest"
      },
      "ios": {
        "image": "latest",
        "resourceClass": "m-medium"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_ENV": "development"
      },
      "android": { "gradleCommand": ":app:assembleDebug" },
      "ios": { "simulator": true }
    },
    "development-device": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_ENV": "development"
      },
      "android": { "buildType": "apk" },
      "ios": { "simulator": false }
    },
    "staging": {
      "extends": "base",
      "distribution": "internal",
      "channel": "staging",
      "env": {
        "APP_ENV": "staging",
        "EXPO_PUBLIC_SUPABASE_URL": "$STAGING_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "$STAGING_SUPABASE_ANON_KEY",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": "$STAGING_STRIPE_PUBLISHABLE_KEY",
        "EXPO_PUBLIC_SENTRY_ENV": "staging"
      },
      "android": { "buildType": "apk" },
      "ios": { "buildConfiguration": "Release" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_SUPABASE_URL": "$PROD_SUPABASE_URL",
        "EXPO_PUBLIC_SUPABASE_ANON_KEY": "$PROD_SUPABASE_ANON_KEY",
        "EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY": "$PROD_STRIPE_PUBLISHABLE_KEY",
        "EXPO_PUBLIC_SENTRY_ENV": "production"
      },
      "android": { "buildType": "app-bundle" },
      "ios": { "buildConfiguration": "Release" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "$APPLE_ID",
        "ascAppId": "$APPLE_ASC_APP_ID",
        "appleTeamId": "$APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "staging": {
      "android": {
        "serviceAccountKeyPath": "./secrets/play-service-account.json",
        "track": "internal"
      }
    }
  }
}
